# =============== Project-wide Ignores ===============
# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs & Temporary Files
*.log
temp/
tmp/

# =============== Python / ML Specific Ignores ===============
# Virtual Environments
venv/
.venv/
env/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Database files
*.sqlite3
db.sqlite3

# ML Models & Distribution
.eggs/
*.egg-info/
dist/
build/
*.h5
*.tf
.ipynb_checkpoints/

# =============== Node.js / React Specific Ignores ===============
node_modules/
**/node_modules/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env.local
.env.development.local
.env.test.local
.env.production.local

# =============== PHP / Laravel Specific Ignores ===============
# Matches 'vendor' anywhere (e.g., in laravel-front/vendor)
**/vendor/

# Laravel framework cache files (The files you saw in your merge)
**/bootstrap/cache/*.php

# Environment variables
**/.env

# Laravel storage folder (logs, sessions, compiled views)
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*.php
**/storage/logs/*.log

# Testing & Tools
.phpunit.result.cache
**/output.txt
**/Homestead.yaml
**/Homestead.json
**/Vagrantfile

# Frontend build files (Vite/Mix)
**/public/build/
**/public/hot
